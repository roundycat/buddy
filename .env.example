# Bedi — local environment template
# Copy to `.env.local` and fill in values:
#   cp .env.example .env.local
#
# Security: rotate any keys that were previously committed or pasted into chat.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Persistence: json (local .data) | dynamodb (AWS BediApp table)
# Cloud / ECS must use dynamodb. json is local-dev mirror only.
# ------------------------------------------------------------
PERSISTENCE=json
BEDI_DDB_TABLE=BediApp

# ------------------------------------------------------------
# LLM provider: mock | bedrock
# ------------------------------------------------------------
LLM_PROVIDER=bedrock
# Local default true; production ECS should set false explicitly.
LLM_FALLBACK_TO_MOCK=true

# ------------------------------------------------------------
# Auth: dynamodb (default) | mock (local only)
# ------------------------------------------------------------
AUTH_PROVIDER=dynamodb
# Use a long random string (≥32 chars). Never commit real secrets.
# Example below is a local placeholder only.
AUTH_SESSION_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# ------------------------------------------------------------
# AWS (DynamoDB + Bedrock)
# Prefer IAM role on ECS; keys only for local tests.
# Leave access keys unset and use AWS CLI profile / instance role when possible.
# ------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Use an inference profile id (us.* / global.*), not legacy on-demand model ids
# Compat / default for non-chat callers
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Immediate child chat (speed) — Haiku
BEDROCK_MODEL_ID_CHAT=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Batch / quality (stories, empathy compose, etc.)
BEDROCK_MODEL_ID_QUALITY=us.anthropic.claude-opus-4-6-v1
# Bedrock Guardrail (STEP 3) — set after scripts/aws/09-guardrail.ps1
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=1
# Bedrock Knowledge Base (STEP 6) — set after scripts/aws/11-knowledge-base.ps1
# BEDROCK_KB_ID=
# Persona crayon avatar (Stability Ultra + remove-bg in us-west-2)
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-ultra-v1:1
BEDROCK_IMAGE_REGION=us-west-2
BEDROCK_IMAGE_REMOVE_BG_MODEL_ID=us.stability.stable-image-remove-background-v1:0
# Optional: private S3 for avatar binaries (ECS). Local falls back to .data/avatars
# AVATAR_S3_BUCKET=bedi-codebuild-ACCOUNT-us-east-1
# AVATAR_S3_REGION=us-east-1
# Optional local dirs when S3 is unset
# AVATAR_LOCAL_DIR=.data/avatars
# PHOTO_LOCAL_DIR=.data/photos
# SCHEDULE_IMAGE_LOCAL_DIR=.data/schedule-images
# Optional: disable custom metrics (0=off)
# BEDDY_METRICS=1
# Dev-only persona reset route — never set on ECS
# ALLOW_DEV_ROUTES=0

# Dawn batch cron (EventBridge → POST /api/cron/daily, header x-bedi-cron-secret)
# Also unlocks detailed GET /api/health in production (x-bedi-health-secret)
CRON_SECRET=

# AWS_SESSION_TOKEN=
